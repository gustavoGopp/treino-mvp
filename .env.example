# Copie para .env.local (nunca versionado). Na Vercel, configure em Settings → Environment Variables.

# --- Servidor (só a função /api/vision) ---
# Obrigatória para o reconhecimento por foto; sem ela, a função responde 503 e o app usa a lista.
ANTHROPIC_API_KEY=
# Códigos de convite do beta, separados por vírgula.
CONVITES=
# Opcional: modelo da visão (o padrão está em api/_lib/modelo.ts).
VISION_MODEL=
# Opcionais: limite diário compartilhado entre as instâncias (Upstash, pela integração da Vercel).
# Também valem UPSTASH_REDIS_REST_URL e UPSTASH_REDIS_REST_TOKEN. Sem elas, o limite é por instância, em memória.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Build do app (entram no código do navegador: nada secreto aqui) ---
# "ligada" mostra a tela da foto do equipamento; qualquer outro valor a esconde.
VITE_FOTO=
# E-mail do canal de problemas e dos pedidos sobre dados (LGPD) e nome de quem mantém o app.
VITE_CONTATO_EMAIL=
VITE_RESPONSAVEL=
