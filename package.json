{
  "name": "treino-mvp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run test",
    "qa:motor": "node scripts/qa-motor.mjs",
    "auditoria": "npm run auditoria:estresse && npm run auditoria:progressao && npm run auditoria:base && npm run auditoria:anatomia && npm run auditoria:minimo && npm run auditoria:minimo-progressao && npm run auditoria:catalogo && npm run auditoria:qualidade && npm run auditoria:regua && npm run auditoria:avaliador",
    "auditoria:estresse": "vite-node scripts/auditoria/estresse.ts --",
    "auditoria:progressao": "vite-node scripts/auditoria/progressao.ts --",
    "auditoria:base": "vite-node scripts/auditoria/base.ts",
    "auditoria:anatomia": "vite-node scripts/auditoria/anatomia.ts",
    "auditoria:minimo": "vite-node scripts/auditoria/minimo.ts --",
    "auditoria:minimo-progressao": "vite-node scripts/auditoria/minimo-progressao.ts",
    "test:cobertura": "vitest run --coverage",
    "test:privado": "vitest run --config privado/vitest.config.ts",
    "gif:jornada": "bash scripts/gif/gerar.sh",
    "gif:sessao": "bash scripts/gif/gerar.sh sessao docs/img/m5-treino.gif",
    "eval:visao": "tsx scripts/eval-vision.ts",
    "auditoria:catalogo": "vite-node scripts/auditoria/catalogo.ts",
    "auditoria:qualidade": "vite-node scripts/auditoria/qualidade.ts --",
    "auditoria:regua": "vite-node scripts/auditoria/grade-regua.ts --",
    "auditoria:avaliador": "vite-node scripts/auditoria/avaliador.ts --",
    "auditoria:verificar": "node scripts/auditoria/verificar.mjs",
    "ler-export": "vite-node scripts/export/ler-export.ts --"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "idb-keyval": "^6.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.7",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.13.0",
    "playwright": "1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.4.5",
    "vite-node": "^3.2.4",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7"
  }
}
